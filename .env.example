# --- Supabase (obligatoire) ---
# URL sans /rest/v1/ à la fin
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Audit / migrations SQL automatiques (optionnel, local uniquement)
# SUPABASE_ACCESS_TOKEN=sbp_...   # Account > Access Tokens
# SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:6543/postgres

# --- App (obligatoire) ---
NEXT_PUBLIC_APP_URL=https://app.wazo-digital.com
NEXT_PUBLIC_LANDING_URL=https://wazo-digital.com

# Google Search Console — balise de verification (optionnel, meme code sur landing + app)
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Indexation automatique IndexNow + Bing (cron /api/cron/submit-indexing)
# INDEXNOW_KEY=optional-fixed-key-32-chars-hex

# --- Paiement abonnement (PayDunya) ---
# live = production PayDunya | test = sandbox | simulate = dev sans PayDunya
PAYMENT_MODE=live
PAYMENT_ALLOW_SIMULATE_FALLBACK=false
PAYMENT_PROVIDER=paydunya

# PayDunya (si PAYMENT_PROVIDER=paydunya)
PAYMENT_API_KEY=your-paydunya-master-key
PAYMENT_SECRET_KEY=your-paydunya-private-key
PAYMENT_TOKEN=your-paydunya-token

# CinetPay (si PAYMENT_PROVIDER=cinetpay)
# PAYMENT_API_KEY = apikey CinetPay
CINETPAY_SITE_ID=your-cinetpay-site-id

# Sécurité callback webhook (OBLIGATOIRE en production)
PAYMENT_CALLBACK_SECRET=generate-a-long-random-secret

# --- Optionnel ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# OpenWeatherMap (optionnel — sans clé, Open-Meteo gratuit est utilisé)
OPENWEATHER_API_KEY=
# Coordonnées par défaut si GPS refusé (Dakar)
# AGRICULTURE_DEFAULT_LAT=14.7167
# AGRICULTURE_DEFAULT_LON=-17.4677

# --- Sync cloud / e-mail hebdo / push (migration 007) ---
# Générer VAPID: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:votre@email.com

# Resend (https://resend.com) — envoi rapport lundi
RESEND_API_KEY=
REPORT_EMAIL_FROM=Wazo Digital <onboarding@wazo-digital.com>
# REPORT_EMAIL_SIMULATE=true

# Assistant « Que faire aujourd'hui ? » — rédaction WhatsApp (Vercel AI Gateway)
# Sur Vercel : activer AI Gateway (OIDC). En local : vercel env pull ou AI_GATEWAY_API_KEY
# ASSISTANT_MODEL=openai/gpt-5-mini
# ASSISTANT_VISION_MODEL=google/gemini-2.5-flash
# ASSISTANT_SIMULATE=true
# AI_GATEWAY_API_KEY= (optionnel si OIDC indisponible)

# Secret pour /api/cron/weekly-report (Vercel Cron envoie Authorization: Bearer ...)
CRON_SECRET=generate-a-long-random-secret

# Meta — publication Facebook/Instagram par boutique (commerçants)
# Même App Meta que le marketing Wazo. Ajouter aussi l'URI de callback :
# https://app.wazo-digital.com/api/social/meta/callback
# META_APP_ID=
# META_APP_SECRET=

# --- Blockchain Celo (traçabilité on-chain) ---
# simulate = hash local | alfajores = testnet | celo = MAINNET (production)
CELO_MODE=celo
# Clé privée du wallet qui paie le gas (jamais côté client)
# CELO_PRIVATE_KEY=0x...
# CELO_RPC_URL=https://forno.celo.org
# Contrat WazoTraceRegistry deploye (optionnel — sinon ancrage via calldata tx)
# CELO_REGISTRY_ADDRESS=0x...

# --- SMS transactionnels (rappels, livraisons — PAS l'auth) ---
# Voir docs/SUPABASE_SMS_AUTH.md — auth OTP téléphone abandonnée
SMS_SIMULATE=false
SMS_PROVIDER=africastalking
AT_API_KEY=
AT_USERNAME=
AT_SENDER_ID=
# Ne pas activer le hook Send SMS dans Supabase Auth
# SEND_SMS_HOOK_SECRET=
